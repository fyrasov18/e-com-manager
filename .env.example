DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jodyshop?schema=public"
NEXTAUTH_SECRET="change-me"
AUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Jody Shop"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ADMIN_EMAIL="admin@jodyshop.tn"

# Protects /api/cron/* routes. External cron callers can send:
# - x-cron-secret: value
# - Authorization: Bearer value
# - ?secret=value
CRON_SECRET="change-me-cron-secret"

# Rate limiting. Use Upstash Redis in production for durable counters.
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_STRICT_MODE="false"
TRUST_PROXY_HEADERS=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Automatic order import from a connected shop/platform JSON API.
AUTO_ORDER_IMPORT_ENABLED="false"
AUTO_ORDER_IMPORT_PROVIDER="GENERIC"
AUTO_ORDER_IMPORT_URL="https://example.com/api/orders"
AUTO_ORDER_IMPORT_INTERVAL_MINUTES="15"
AUTO_ORDER_IMPORT_LOOKBACK_HOURS="24"
AUTO_ORDER_IMPORT_SAFETY_WINDOW_MINUTES="10"
AUTO_ORDER_IMPORT_LIMIT="100"

# Optional query params added to AUTO_ORDER_IMPORT_URL.
# Example Shopify: AUTO_ORDER_IMPORT_SINCE_PARAM="created_at_min"
# Example generic API: AUTO_ORDER_IMPORT_SINCE_PARAM="updated_after"
AUTO_ORDER_IMPORT_SINCE_PARAM=""
AUTO_ORDER_IMPORT_LIMIT_PARAM=""

# Optional authentication for the connected source.
AUTO_ORDER_IMPORT_AUTH_HEADER=""
AUTO_ORDER_IMPORT_BEARER_TOKEN=""
AUTO_ORDER_IMPORT_API_KEY_HEADER=""
AUTO_ORDER_IMPORT_API_KEY=""

# Keep true for the same validation rule as manual Excel import.
AUTO_ORDER_IMPORT_REQUIRE_PHONE="true"

# InstaviaDelivery credentials
INSTAVIA_LOGIN="votre_login"
INSTAVIA_PASSWORD="votre_mot_de_passe"

# Colissimo secret key for AES-256-GCM credential encryption
COLISSIMO_SECRET_KEY="change-me"

# SMTP Configuration (optional)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="votre-email@gmail.com"
# SMTP_PASS="votre-mot-de-passe-app"
